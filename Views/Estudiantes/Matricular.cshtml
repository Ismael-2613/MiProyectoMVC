@model MiProyectoMVC.Models.ClsMatriculas
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <title>Matricularse - CodeLab Academy</title>
    <link rel="stylesheet" href="/css/menu.css" />
    <link rel="stylesheet" href="/css/matricular.css" />
</head>

<body>

    <nav class="navbar">
        <div class="logo">
            <span>💻 CodeLab Academy</span>
            <span class="version">v1.0.0</span>
        </div>
        <ul class="nav-links">
            <li><a href="/Usuarios/MenuEstudiantes">Inicio</a></li>
            <li><a href="/Estudiantes/Cursos">Cursos</a></li>
            <li><a href="/Usuarios/Login">Cerrar sesión</a></li>
        </ul>
    </nav>

    <div class="matricular-container">
        <div class="matricular-card">
            <h2>Matricularse</h2>
            <p class="subtitle">Completa tus datos para inscribirte</p>

            @if (ViewBag.Exito == true || ViewBag.YaMatriculado == true)
            {
                <div class="success">
                    ✅ @ViewBag.Mensaje <br />
                    <small>Te enviaremos un correo cuando inicien las clases.</small>
                </div>
                <a href="/Estudiantes/VerCurso/@ViewBag.IdCurso" class="btn-ver-curso">
                    Ver Curso
                </a>
            }
            else
            {
                @if (ViewBag.Exito == false)
                {
                    <div class="error"> @ViewBag.Mensaje</div>
                }

                <form asp-action="Matricular" method="post">
                    <input type="hidden" name="Tbl_Fk_Id_Curso" value="@ViewBag.IdCurso" />

                    <div class="form-group">
                        <label>Nombre completo</label>
                        <input asp-for="Tbl_Nombre" placeholder="Tu nombre" />
                    </div>

                    <div class="form-group">
                        <label>Usuario</label>
                        <input asp-for="Tbl_Email" placeholder="Tu usuario" />
                    </div>

                    <button type="submit" class="btn-matricular">Matricularme</button>
                </form>
            }
        </div>
    </div>

</body>

</html>