@model MiProyectoMVC.Models.ClsUsuarios

@{
    Layout = null;
}

<!DOCTYPE html>
<html>

<head>
    <title>Registrar Usuario</title>
    <link rel="stylesheet" href="/css/site.css">
</head>

<body>
    <div class="card">
        <h2>Registrar Usuario</h2>

        @if (ViewBag.Mensaje != null)
        {
            <p class="success">@ViewBag.Mensaje</p>
        }

        
        <form asp-action="Registrar" method="post">

           
            <div class="form-group">
                <label>Usuario</label>
                <input asp-for="Tbl_Username" placeholder="Usuario" />
            </div>

            <div class="form-group">
                <label>Password</label>
                <input asp-for="Tbl_Pass" type="password" placeholder="Password" />
            </div>

            <button type="submit">Registrar</button>
        </form>
    </div>
</body>

</html>