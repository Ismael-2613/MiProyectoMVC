@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Sistema Operativos</title>
    <link rel="stylesheet" href="/css/menu.css" />
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar">
        <div class="logo">
            <span>🐧 SistemaOS</span>
            <span class="version">v1.0.0</span>
        </div>
        <ul class="nav-links">
            <li><a href="/Usuarios/Menu">Inicio</a></li>
            <li><a href="/Usuarios/Registrar">Registrar</a></li>
            <li><a href="/Usuarios/Login">Login</a></li>
            <li><a href="/Usuarios/Login">Cerrar sesión</a></li>
        </ul>
    </nav>

    <!-- HERO -->
    <div class="hero">
        <span class="badge">🟢 Sistema en línea</span>
        <h1>Proyecto Sistema Operativos</h1>
        <p>Plataforma de gestión basada en arquitectura OpenSUSE</p>
    </div>

    <!-- CARDS -->
    <div class="cards-container">
        <div class="card">
            <div class="icon">👤</div>
            <h3>Usuarios</h3>
            <p>Gestión de usuarios del sistema</p>
        </div>
        <div class="card">
            <div class="icon">🖥️</div>
            <h3>Procesos</h3>
            <p>Monitor de procesos activos</p>
        </div>
        <div class="card">
            <div class="icon">📁</div>
            <h3>Archivos</h3>
            <p>Sistema de archivos</p>
        </div>
        <div class="card">
            <div class="icon">🔒</div>
            <h3>Seguridad</h3>
            <p>Configuración de permisos</p>
        </div>
        <div class="card">
            <div class="icon">📊</div>
            <h3>Reportes</h3>
            <p>Estadísticas del sistema</p>
        </div>
        <div class="card">
            <div class="icon">⚙️</div>
            <h3>Configuración</h3>
            <p>Ajustes del sistema</p>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
        © 2026 SistemaOS · Basado en OpenSUSE · Todos los derechos reservados
    </div>

</body>
</html>