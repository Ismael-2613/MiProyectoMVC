@model MiProyectoMVC.Models.Contenido.ClsContenidoRequest
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Agregar Contenido - CodeLab Academy</title>
    <link rel="stylesheet" href="/css/menu.css" />
    <link rel="stylesheet" href="/css/estilos.css" />
</head>
<body>

    <nav class="navbar">
        <div class="logo">
            <span>💻 CodeLab Academy</span>
            <span class="version">v1.0.0</span>
        </div>
        <ul class="nav-links">
            <li><a href="/Usuarios/MenuProfesores">Inicio</a></li>
            <li><a href="/Usuarios/Login">Cerrar sesión</a></li>
        </ul>
    </nav>

    <div style="display:flex; justify-content:center; align-items:center; min-height:80vh;">
        <div class="card">
            <h2>📂 Agregar Contenido</h2>
            <p class="subtitle">Agrega un video o documento al módulo</p>

            @if (ViewBag.Error != null)
            {
                <div class="error">❌ @ViewBag.Error</div>
            }

            <form asp-action="AgregarContenido" method="post" enctype="multipart/form-data">
                <input type="hidden" name="Tbl_Fk_Id_Curso" value="@ViewBag.IdCurso" />

                <div class="form-group">
                    <label>Título</label>
                    <input asp-for="Tbl_Titulo" placeholder="Ej: Introducción a HTML" />
                </div>

                <div class="form-group">
                    <label>Tipo</label>
                    <select name="Tbl_Tipo" style="width:100%; padding:12px; border:2px solid #e0e0e0; border-radius:8px; font-size:15px; background:white;">
                        <option value="Video">🎥 Video</option>
                        <option value="Documento">📄 Documento</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Subir archivo</label>
                    <input type="file" name="archivo" accept="video/*,.pdf,.doc,.docx,.mp4,.avi,.mkv"
                           style="width:100%; padding:8px; border:2px solid #e0e0e0; border-radius:8px; color:#555;" />
                </div>

                <button type="submit">Agregar Contenido</button>
            </form>
        </div>
    </div>

</body>
</html>